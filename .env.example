# ms-notificaciones — plantilla de variables de entorno
# Copia a `.env` y completa. NUNCA subas `.env` a git.

# --- MongoDB ---
# Formato: mongodb://user:pass@host:port/db?authSource=admin&uuidRepresentation=standard
MONGO_URI=

# --- Keycloak (issuer del realm por ambiente) ---
KEYCLOAK_ISSUER_URI=
